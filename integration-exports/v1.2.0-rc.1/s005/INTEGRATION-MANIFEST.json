        "objectRef",
        "dataVersionId",
        "ontologyVersionId",
        "asOf",
        "lensIntent"
      ],
      "prohibitedWrites": ["businessFact", "publishedResource", "actionRequest"]
    },
    "M08": {
      "routeId": "module/modeling",
      "direction": "S005-to-M08",
      "mode": "research-simulation",
      "requiredInput": [
        "scenarioContext",
        "objectRef",
        "modelingObjectiveRef",
        "dataVersionId",
        "ontologyVersionId",
        "evaluationInputRef",
        "resultKind"
      ],
      "allowedResultKinds": ["PREDICTED", "SIMULATED"],
      "prohibitedWrites": ["businessFact", "t019", "actionRequest", "tradeInstruction"]
    }
  },
  "resetBoundary": {
    "scope": "current S005 scenario run only",
    "createsNewScenarioRunId": true,
    "preservesHistoricalRuns": true,
    "preservesModules": ["M01", "M02", "M03", "M04", "M05", "M06", "M07", "M08"],
