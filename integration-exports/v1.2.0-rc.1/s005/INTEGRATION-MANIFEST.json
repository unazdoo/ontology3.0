    { "order": 1, "stageId": "sourceBatch", "moduleId": "M02", "label": "来源快照" },
    { "order": 2, "stageId": "classification", "moduleId": "M01", "label": "分类与语义" },
    { "order": 3, "stageId": "compliance", "moduleId": "M03", "label": "持续合规" },
    { "order": 4, "stageId": "marketPeer", "moduleId": "M03", "label": "市场横评" },
