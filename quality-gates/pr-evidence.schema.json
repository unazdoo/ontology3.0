{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ontology3.example/contracts/implementation-quality-evidence.v1.json",
  "title": "Implementation quality gate evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "manifestVersion",
    "gateVersion",
    "baselineSnapshotId",
    "sourceTag",
    "sourceVersion",
    "implementationVersion",
    "implementationRoundId",
    "pullRequest",
    "schemaVersion",
    "schemaVersions",
    "schemaCompatibility",
    "owner",
    "providers",
    "consumers",
    "databaseMigration",
    "objectStorageFingerprint",
    "rollback",
    "runtimeRunId",
    "runtimeRunIsReal",
    "audit",
    "negativeTests",
    "recoveryReceipt",
    "prEnvironment",
    "checks",
    "candidateGates",
    "receipts"
  ],
  "properties": {
    "manifestVersion": { "const": "implementation-quality-evidence.v2" },
    "gateVersion": { "const": "implementation-quality-gate.v1" },
    "baselineSnapshotId": { "const": "BSL-OFW-V110-94ABD0E991B7" },
    "sourceTag": { "type": "string", "minLength": 1 },
    "sourceVersion": { "type": "string", "minLength": 1 },
    "implementationVersion": { "type": "string", "minLength": 1 },
    "implementationRoundId": { "type": "string", "minLength": 1 },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "headSha"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "headSha": { "type": "string", "pattern": "^[a-fA-F0-9]{7,64}$" }
      }
    },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "schemaVersions": {
      "oneOf": [
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } }
      ]
    },
    "schemaCompatibility": {
      "oneOf": [
        { "type": "string", "enum": ["exact", "compatible", "approved-additive", "review"] },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["exact", "compatible", "approved-additive", "review"] },
            "evidence": { "type": "string", "minLength": 1 },
            "evidenceUri": { "type": "string", "minLength": 1 },
            "owner": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "owner": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "team": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "providers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "consumers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "databaseMigration": {
      "allOf": [{ "$ref": "#/definitions/evidence" }],
      "required": ["up", "down"]
    },
    "objectStorageFingerprint": {
      "type": "object",
      "required": ["status", "algorithm", "value", "prefix"],
      "properties": {
        "status": { "type": "string" },
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "prefix": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "evidenceUri": { "type": "string", "minLength": 1 }
      }
    },
    "rollback": {
      "allOf": [{ "$ref": "#/definitions/evidence" }],
      "required": ["targetVersion"]
    },
    "runtimeRunId": { "type": "string", "minLength": 8 },
    "runtimeRunIsReal": { "const": true },
    "audit": {
      "type": "object",
      "required": ["actorRef", "traceId", "correlationId", "idempotencyKey", "formedAt", "scenarioContext", "appendOnly"],
      "properties": {
        "actorRef": { "type": "string", "minLength": 1 },
        "traceId": { "type": "string", "minLength": 1 },
        "correlationId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "formedAt": { "type": "string", "minLength": 1 },
        "appendOnly": { "const": true },
        "scenarioContext": { "type": "object", "required": ["scenarioId", "scenarioVersion", "scenarioRunId", "formedAt", "status"] },
        "evidence": { "type": "string", "minLength": 1 },
        "evidenceUri": { "type": "string", "minLength": 1 }
      }
    },
    "negativeTests": { "$ref": "#/definitions/evidence" },
    "recoveryReceipt": {
      "type": "object",
      "required": ["status", "sourceScenarioRunId", "restoredScenarioRunId", "sideEffectsSuppressed", "overwritesSource"],
      "properties": {
        "status": { "type": "string" },
        "sourceScenarioRunId": { "type": "string", "minLength": 1 },
        "restoredScenarioRunId": { "type": "string", "minLength": 1 },
        "sideEffectsSuppressed": { "const": true },
        "overwritesSource": { "const": false },
        "evidence": { "type": "string", "minLength": 1 },
        "evidenceUri": { "type": "string", "minLength": 1 }
      }
    },
    "prEnvironment": { "$ref": "#/definitions/environment" },
    "checks": {
      "type": "object",
      "required": ["goldenData", "contractCompatibility", "e2e", "permissionNegative", "concurrencyIdempotency", "performance", "accessibility", "security", "sbom", "observability", "c034Recovery", "migration", "rollback", "ciCd"],
      "properties": {
        "goldenData": { "$ref": "#/definitions/check" },
        "contractCompatibility": { "$ref": "#/definitions/check" },
        "e2e": { "$ref": "#/definitions/check" },
        "permissionNegative": { "$ref": "#/definitions/check" },
        "concurrencyIdempotency": { "$ref": "#/definitions/check" },
        "performance": { "$ref": "#/definitions/check" },
        "accessibility": { "$ref": "#/definitions/check" },
        "security": { "$ref": "#/definitions/check" },
        "sbom": { "$ref": "#/definitions/check" },
        "observability": { "$ref": "#/definitions/check" },
        "c034Recovery": { "$ref": "#/definitions/check" },
        "migration": { "$ref": "#/definitions/check" },
        "rollback": { "$ref": "#/definitions/check" },
        "ciCd": { "$ref": "#/definitions/check" }
      }
    },
    "candidateGates": {
      "type": "object",
      "required": ["s001VerticalSlice", "security", "recovery"],
      "properties": {
        "s001VerticalSlice": { "$ref": "#/definitions/candidateGate" },
        "security": { "$ref": "#/definitions/candidateGate" },
        "recovery": { "$ref": "#/definitions/candidateGate" }
      }
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provisioning", "databaseMigration", "objectStorageFingerprint", "rollback", "runtime", "audit", "negativeTests", "recovery", "checks"],
      "properties": {
        "provisioning": { "$ref": "#/definitions/receiptReference" },
        "databaseMigration": { "$ref": "#/definitions/receiptReference" },
        "objectStorageFingerprint": { "$ref": "#/definitions/receiptReference" },
        "rollback": { "$ref": "#/definitions/receiptReference" },
        "runtime": { "$ref": "#/definitions/receiptReference" },
        "audit": { "$ref": "#/definitions/receiptReference" },
        "negativeTests": { "$ref": "#/definitions/receiptReference" },
        "recovery": { "$ref": "#/definitions/receiptReference" },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goldenData", "contractCompatibility", "e2e", "permissionNegative", "concurrencyIdempotency", "performance", "accessibility", "security", "sbom", "observability", "c034Recovery", "migration", "rollback", "ciCd"],
          "properties": {
            "goldenData": { "$ref": "#/definitions/receiptReference" },
            "contractCompatibility": { "$ref": "#/definitions/receiptReference" },
            "e2e": { "$ref": "#/definitions/receiptReference" },
            "permissionNegative": { "$ref": "#/definitions/receiptReference" },
            "concurrencyIdempotency": { "$ref": "#/definitions/receiptReference" },
            "performance": { "$ref": "#/definitions/receiptReference" },
            "accessibility": { "$ref": "#/definitions/receiptReference" },
            "security": { "$ref": "#/definitions/receiptReference" },
            "sbom": { "$ref": "#/definitions/receiptReference" },
            "observability": { "$ref": "#/definitions/receiptReference" },
            "c034Recovery": { "$ref": "#/definitions/receiptReference" },
            "migration": { "$ref": "#/definitions/receiptReference" },
            "rollback": { "$ref": "#/definitions/receiptReference" },
            "ciCd": { "$ref": "#/definitions/receiptReference" }
          }
        }
      }
    }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "required": ["status", "evidence", "receiptId", "receiptSha256"],
      "properties": {
        "status": { "type": "string" },
        "evidence": { "type": "string" },
        "evidenceUri": { "type": "string" },
        "receiptUri": { "type": "string" },
        "receiptId": { "type": "string", "minLength": 1 },
        "receiptSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "check": {
      "type": "object",
      "required": ["status", "evidence", "receiptId", "receiptSha256"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "verified", "not-applicable"] },
        "evidence": { "type": "string", "minLength": 1 },
        "evidenceUri": { "type": "string", "minLength": 1 },
        "receiptUri": { "type": "string", "minLength": 1 },
        "receiptId": { "type": "string", "minLength": 1 },
        "receiptSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "candidateGate": {
      "type": "object",
      "required": ["status", "evidence", "receiptId", "receiptSha256", "roundId"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "verified", "blocked", "not-run"] },
        "evidence": { "type": "string", "minLength": 1 },
        "evidenceUri": { "type": "string", "minLength": 1 },
        "roundId": { "type": "string", "minLength": 1 },
        "implementationRoundId": { "type": "string", "minLength": 1 },
        "receiptId": { "type": "string", "minLength": 1 },
        "receiptSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "environment": {
      "type": "object",
      "required": ["id", "databaseSchema", "objectStoragePrefix", "queueNamespace", "credentialRef", "provisioningReceipt", "provisioningReceiptSha256"],
      "properties": {
        "id": { "type": "string" },
        "databaseSchema": { "type": "string", "minLength": 1 },
        "objectStoragePrefix": { "type": "string", "minLength": 1 },
        "queueNamespace": { "type": "string", "minLength": 1 },
        "credentialRef": { "type": "string", "minLength": 1 },
        "provisioningReceipt": { "type": "string", "minLength": 1 },
        "provisioningReceiptSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "receiptReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "receiptId", "pullRequestNumber", "headSha", "environmentId", "implementationRoundId"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\\\\\).+\\.json$" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "receiptId": { "type": "string", "minLength": 1 },
        "pullRequestNumber": { "type": "integer", "minimum": 1 },
        "headSha": { "type": "string", "pattern": "^[a-fA-F0-9]{7,64}$" },
        "environmentId": { "type": "string", "minLength": 1 },
        "implementationRoundId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
